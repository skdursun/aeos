{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeos-codex-planner-routing-proposal-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aeosCodexWorkerResultVersion",
    "status",
    "workerId",
    "workerFamily",
    "runtimeKind",
    "invocationId",
    "idempotencyKey",
    "taskId",
    "sourceTaskRevision",
    "attemptId",
    "attemptNumber",
    "workItemId",
    "batchId",
    "invocationOk",
    "output",
    "outputReference",
    "diagnosticCode",
    "message"
  ],
  "properties": {
    "aeosCodexWorkerResultVersion": { "type": "integer", "const": 1 },
    "status": { "type": "string", "const": "returned" },
    "workerId": { "type": "string" },
    "workerFamily": { "type": "string", "const": "codex" },
    "runtimeKind": { "type": "string", "const": "test_worker" },
    "invocationId": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "taskId": { "type": "string" },
    "sourceTaskRevision": { "type": "integer" },
    "attemptId": { "type": "string" },
    "attemptNumber": { "type": "integer" },
    "workItemId": { "type": ["string", "null"] },
    "batchId": { "type": ["string", "null"] },
    "invocationOk": { "type": "boolean", "const": true },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routingProposal"],
      "properties": {
        "routingProposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposalId",
            "taskId",
            "sourceTaskRevision",
            "workItemId",
            "batchId",
            "operationKind",
            "recommendedWorkerFamily",
            "capabilityRequirements",
            "reasonReference",
            "expectedOperationClass"
          ],
          "properties": {
            "proposalId": { "type": ["string", "null"] },
            "taskId": { "type": "string" },
            "sourceTaskRevision": { "type": "integer" },
            "workItemId": { "type": "string" },
            "batchId": { "type": ["string", "null"] },
            "operationKind": { "type": "string", "const": "execute_task_attempt" },
            "recommendedWorkerFamily": { "type": "string", "const": "claude_code" },
            "capabilityRequirements": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "implementation",
                  "repositoryRead",
                  "modelReasoning",
                  "boundedDiagnostics"
                ]
              }
            },
            "reasonReference": {
              "type": "string",
              "const": "aeos://task/TASK-0324/operation/read-only-routed-worker-canary"
            },
            "expectedOperationClass": { "type": "string", "const": "implementation" }
          }
        }
      }
    },
    "outputReference": { "type": ["string", "null"] },
    "diagnosticCode": { "type": "string", "const": "task_0324_codex_planner_routing_proposal" },
    "message": { "type": ["string", "null"] }
  }
}

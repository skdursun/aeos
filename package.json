{
  "name": "pro-performans",
  "private": true,
  "description": "AEOS TypeScript monorepo scaffold.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "clean": "find . -name dist -type d -prune -exec rm -rf {} +",
    "core:check": "pnpm --filter @aeos/core check",
    "core:build": "pnpm --filter @aeos/core build",
    "core:verify": "pnpm core:check && pnpm core:build",
    "cli:check": "pnpm --filter @aeos/cli check",
    "cli:build": "pnpm --filter @aeos/cli build",
    "cli:smoke": "pnpm --filter @aeos/cli smoke",
    "cli:verify": "pnpm cli:check && pnpm cli:build && pnpm cli:smoke"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
